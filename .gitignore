# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# The app's own lock file is tracked, but the vendored plugins are libraries —
# their lock files are resolution artifacts of analyzing them standalone and
# say nothing about what the app actually builds against.
/third_party/*/pubspec.lock
/third_party/*/example/pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle / CMake build artifacts (app and vendored plugins)
**/.cxx/
**/.gradle/
**/build/

# Mobile QA run artifacts — large/binary/ephemeral, regenerated by
# testing/mobile/*.ps1. Bug reports (small markdown, worth keeping) are NOT
# ignored — only screenshots/recordings/logs, which are the bulky ones.
/testing/mobile/screenshots/*
/testing/mobile/recordings/*
/testing/mobile/logs/*
!/testing/mobile/screenshots/.gitkeep
!/testing/mobile/recordings/.gitkeep
!/testing/mobile/logs/.gitkeep
# Exceptions: screenshots cited as evidence in a tracked bug report under
# testing/mobile/reports/ — add one line per kept screenshot, don't bulk-unignore.
!/testing/mobile/screenshots/rescripto_launch_smoketest.png
!/testing/mobile/screenshots/rescripto_rewrite_screen.png
